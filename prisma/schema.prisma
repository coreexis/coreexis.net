generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrderEvent {
  id          String   @id @default(cuid())
  tier        String
  label       String
  countryCode String?
  countryName String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
